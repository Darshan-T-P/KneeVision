# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Community Cloud ->
# App settings -> Secrets. Never commit the real file (it is gitignored).
LLM_PROVIDER = "auto"          # "auto": use Grok when XAI_API_KEY is set, else local Ollama
XAI_API_KEY = "xai-..."        # from https://console.x.ai
XAI_MODEL = "grok-3-mini"      # check the exact model name available to your xAI account
